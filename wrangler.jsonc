{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "whitebophir",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "containers": [
    {
      "class_name": "WhiteboardContainer",
      "image": "./cloudflare/Dockerfile",
      "image_build_context": ".",
      "instance_type": "standard-2",
      "max_instances": 1,
      "constraints": {
        "regions": ["APAC"]
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "WHITEBOARD", "class_name": "WhiteboardContainer" },
      { "name": "STORAGE", "class_name": "WhiteboardStorage" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["WhiteboardContainer", "WhiteboardStorage"]
    }
  ],
  "r2_buckets": [{ "binding": "BOARDS", "bucket_name": "whitebophir-boards" }],
  "observability": { "enabled": true }
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beatbump", "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-04", "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true, "observability": { "enabled": true },
  "containers": [{
    "class_name": "BeatbumpContainer", "image": "./Dockerfile",
    "instance_type": "standard-3", "max_instances": 1,
    "constraints": { "regions": ["APAC"] }
  }],
  "durable_objects": { "bindings": [{ "name": "BEATBUMP", "class_name": "BeatbumpContainer" }] },
  "migrations": [{ "tag": "beatbump-v1", "new_sqlite_classes": ["BeatbumpContainer"] }]
}
